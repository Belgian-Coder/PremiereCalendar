* text=auto

# Keep raw-string bytes stable across Windows and Linux builds.
*.cs text eol=lf

*.cmd text eol=crlf
*.ps1 text eol=crlf

# Scripts and SQL that run inside Linux containers or WSL must stay LF (a CR breaks `sh`, psql meta-commands and shebangs).
*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# Preserve upstream license text, including its original whitespace.
PremiereCalendar/ThirdPartyNotices/Magick.NET-ImageMagick-Notice.txt -whitespace
