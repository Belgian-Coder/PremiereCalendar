@using System.Globalization
@inject IJSRuntime JSRuntime

<section class="calendar-day"
         @ref="_dayElement"
         id="@DayId"
         role="tabpanel"
         aria-labelledby="@LabelledById"
         data-testid="calendar-day"
         data-day-animation-key="@Day.ToString("yyyyMMdd", CultureInfo.InvariantCulture)">
    <div class="day-scroll-prompt day-scroll-prompt-top" data-day-scroll-prompt="previous" aria-hidden="true">
        <span>Scroll to yesterday</span>
    </div>

    <header class="day-header">
        <div>
            <span class="day-date">@Day.ToString("dd MMM", CultureInfo.CurrentCulture)</span>
            <h2>@Day.ToString("dddd", CultureInfo.CurrentCulture)</h2>
        </div>
        <div class="day-header-meta">
            @if (Items.Count > 0)
            {
                <span>@FormatCount(MovieCount, "movie")</span>
                <span>@FormatCount(SeriesCount, "series")</span>
            }
        </div>
    </header>
    <div class="day-separator" aria-hidden="true"></div>

    @if (Items.Count == 0)
    {
        <p class="empty-day">No premieres</p>
    }
    else
    {
        @if (_windowStart > 0)
        {
            <div class="day-window-spacer"
                 style="height: @($"{_trimmedHeightPx.ToString("0.##", CultureInfo.InvariantCulture)}px")"
                 data-day-window-spacer
                 aria-hidden="true"></div>
            <div class="day-window-previous" data-day-window-previous>
                Earlier items load as you scroll up
                <button class="visually-hidden"
                        type="button"
                        data-day-load-previous
                        @onclick="ShowPrevious">
                    Show previous items
                </button>
            </div>
        }

        <div class="day-items-grid">
            @foreach (var item in VisibleVerifiedItems)
            {
                <PremiereCard @key="item.CanonicalId"
                              Item="item"
                              ScoreSource="ScoreSource"
                              ImageCacheVersion="@ImageCacheVersion"
                              RefreshImageCache="RefreshImageCache"
                              IntegrationSettings="IntegrationSettings"
                              OnAddToArr="OnAddToArr"
                              IsArrActionBusy="IsArrActionBusy" />
            }
        </div>

        @if (VisibleUnverifiedItems.Any())
        {
            <section class="unverified-day-section" data-testid="unverified-premieres">
                <div class="unverified-day-separator">
                    <span>Unverified from external sources</span>
                    <small>@FormatCount(VisibleUnverifiedItems.Count, "card")</small>
                </div>
                <div class="day-items-grid">
                    @foreach (var item in VisibleUnverifiedItems)
                    {
                        <PremiereCard @key="item.CanonicalId"
                                      Item="item"
                                      ScoreSource="ScoreSource"
                                      ImageCacheVersion="@ImageCacheVersion"
                                      RefreshImageCache="RefreshImageCache"
                                      IntegrationSettings="IntegrationSettings"
                                      OnAddToArr="OnAddToArr"
                                      IsArrActionBusy="IsArrActionBusy" />
                    }
                </div>
            </section>
        }

        @if (HiddenItemCount > 0)
        {
            <div class="day-load-controls" aria-label="@($"More items for {Day.ToString("dddd", CultureInfo.CurrentCulture)}")">
                <span class="day-visible-count">Showing @WindowStartDisplay-@_visibleCount of @Items.Count</span>
                <button class="tool-button"
                        type="button"
                        data-day-load-more
                        title="@($"Show {NextBatchCount} more items")"
                        @onclick="ShowMore">
                    Show @NextBatchCount more
                </button>
            </div>

            <div class="day-autoload-sentinel" data-day-autoload-sentinel>
                More items load as you scroll
            </div>
        }
    }

    <div class="day-end-spacer" data-day-end-spacer aria-hidden="true"></div>

    <div class="day-scroll-prompt day-scroll-prompt-bottom" data-day-scroll-prompt="next" aria-hidden="true">
        <span>Scroll to tomorrow</span>
    </div>
</section>

@code {
    [Parameter]
    public DateOnly Day { get; set; }

    [Parameter]
    public string WindowScope { get; set; } = "";

    [Parameter]
    public string DayId { get; set; } = "";

    [Parameter]
    public string LabelledById { get; set; } = "";

    [Parameter]
    public IReadOnlyList<PremiereItem> Items { get; set; } = [];

    [Parameter]
    public ScoreSource ScoreSource { get; set; } = ScoreSource.Tmdb;

    [Parameter]
    public string? ImageCacheVersion { get; set; }

    [Parameter]
    public bool RefreshImageCache { get; set; }

    [Parameter]
    public IntegrationSettings IntegrationSettings { get; set; } = new();

    [Parameter]
    public EventCallback<PremiereItem> OnAddToArr { get; set; }

    [Parameter]
    public bool IsArrActionBusy { get; set; }

    [Parameter]
    public bool IsUpdating { get; set; }

    [Parameter]
    public int InitialVisibleCount { get; set; } = 10;

    [Parameter]
    public int LoadBatchSize { get; set; } = 10;

    [Parameter]
    public int MaxMountedItemCount { get; set; } = 40;

    private int _visibleCount;
    private int _windowStart;
    private double _trimmedHeightPx;
    private readonly Stack<WindowSlice> _trimmedSlices = new();
    private ElementReference _dayElement;
    private DateOnly? _windowDay;
    private string _lastWindowScope = "";
    private string _itemsSignature = "";
    private IReadOnlyList<PremiereItem>? _lastItemsReference;
    private int _lastItemsCount = -1;
    private int _partitionVisibleCount = -1;
    private string _lastRenderFingerprint = "";
    private bool _shouldRender = true;
    private IReadOnlyList<PremiereItem> _visibleItems = [];
    private IReadOnlyList<PremiereItem> _visibleVerifiedItems = [];
    private IReadOnlyList<PremiereItem> _visibleUnverifiedItems = [];
    private int _movieCount;
    private int _seriesCount;

    private int MovieCount => _movieCount;

    private int SeriesCount => _seriesCount;

    private int HiddenItemCount => Math.Max(0, Items.Count - _visibleCount);

    private int MountedItemCount => Math.Max(0, _visibleCount - _windowStart);

    private int WindowStartDisplay => Items.Count == 0 ? 0 : _windowStart + 1;

    private int InitialCount => Math.Min(Items.Count, Math.Max(10, InitialVisibleCount));

    private int NextBatchCount => Math.Min(Math.Max(1, LoadBatchSize), HiddenItemCount);

    private IReadOnlyList<PremiereItem> VisibleVerifiedItems => _visibleVerifiedItems;

    private IReadOnlyList<PremiereItem> VisibleUnverifiedItems => _visibleUnverifiedItems;

    protected override void OnParametersSet()
    {
        var canReuseItemsSignature = ReferenceEquals(Items, _lastItemsReference)
            && Items.Count == _lastItemsCount
            && !string.IsNullOrEmpty(_itemsSignature);
        var signature = canReuseItemsSignature ? _itemsSignature : BuildItemsSignature();
        var itemsChanged = !string.Equals(signature, _itemsSignature, StringComparison.Ordinal);
        var hasMountedItemOverlap = _visibleItems.Count == 0
            || _visibleItems.Any(previous => Items.Any(current =>
                string.Equals(current.CanonicalId, previous.CanonicalId, StringComparison.Ordinal)));
        var resetWindow = _windowDay is { } windowDay && windowDay != Day
            || !string.Equals(_lastWindowScope, WindowScope, StringComparison.Ordinal)
            || _lastItemsCount > 0 && Items.Count == 0
            || _lastItemsCount > 0 && Items.Count > 0 && !hasMountedItemOverlap;
        _windowDay = Day;
        _lastWindowScope = WindowScope;

        if (resetWindow)
        {
            ResetWindow();
            itemsChanged = true;
        }

        if (itemsChanged)
        {
            RebuildItemCounts();
        }

        _lastItemsReference = Items;
        _lastItemsCount = Items.Count;

        if (itemsChanged)
        {
            _itemsSignature = signature;
            _visibleCount = _visibleCount <= 0
                ? InitialCount
                : Math.Min(Items.Count, Math.Max(_visibleCount, InitialCount));
            _windowStart = Math.Min(_windowStart, Math.Max(0, _visibleCount - 1));
        }

        if (!itemsChanged)
        {
            _visibleCount = Math.Min(_visibleCount, Items.Count);
            _windowStart = Math.Min(_windowStart, _visibleCount);
        }

        var partitionWindowFingerprint = HashCode.Combine(_windowStart, _visibleCount);
        if (_partitionVisibleCount != partitionWindowFingerprint || itemsChanged)
        {
            RebuildVisiblePartitions();
        }

        var renderFingerprint = BuildRenderFingerprint();
        _shouldRender = !string.Equals(renderFingerprint, _lastRenderFingerprint, StringComparison.Ordinal);
        _lastRenderFingerprint = renderFingerprint;
    }

    protected override bool ShouldRender()
    {
        return _shouldRender;
    }

    private async Task ShowMore()
    {
        var nextVisibleCount = Math.Min(Items.Count, _visibleCount + Math.Max(1, LoadBatchSize));
        var maxMountedItems = Math.Max(Math.Max(1, LoadBatchSize), MaxMountedItemCount);
        var trimCount = Math.Max(0, nextVisibleCount - _windowStart - maxMountedItems);
        if (trimCount > 0)
        {
            var measuredHeight = await MeasureTrimHeightAsync(trimCount);
            _trimmedSlices.Push(new WindowSlice(trimCount, measuredHeight));
            _windowStart += trimCount;
            _trimmedHeightPx += measuredHeight;
        }

        _visibleCount = nextVisibleCount;
        RebuildVisiblePartitions();
        _shouldRender = true;
    }

    private void ShowPrevious()
    {
        if (_trimmedSlices.Count == 0)
        {
            return;
        }

        var restored = _trimmedSlices.Pop();
        _windowStart = Math.Max(0, _windowStart - restored.ItemCount);
        _visibleCount = Math.Max(_windowStart, _visibleCount - restored.ItemCount);
        _trimmedHeightPx = Math.Max(0, _trimmedHeightPx - restored.HeightPx);
        RebuildVisiblePartitions();
        _shouldRender = true;
    }

    private async Task<double> MeasureTrimHeightAsync(int itemCount)
    {
        try
        {
            return Math.Max(0, await JSRuntime.InvokeAsync<double>(
                "premiereCalendarDayWindow.measureTrimHeight",
                _dayElement,
                itemCount));
        }
        catch (InvalidOperationException)
        {
            return 0;
        }
        catch (JSDisconnectedException)
        {
            return 0;
        }
    }

    private void ResetWindow()
    {
        _visibleCount = 0;
        _windowStart = 0;
        _trimmedHeightPx = 0;
        _trimmedSlices.Clear();
    }

    private void RebuildItemCounts()
    {
        _movieCount = 0;
        _seriesCount = 0;
        foreach (var item in Items)
        {
            if (item.MediaType == PremiereMediaType.Movie)
            {
                _movieCount++;
            }
            else if (item.MediaType == PremiereMediaType.Series)
            {
                _seriesCount++;
            }
        }
    }

    private void RebuildVisiblePartitions()
    {
        var visibleItems = Items
            .Skip(_windowStart)
            .Take(MountedItemCount)
            .ToArray();
        _visibleItems = visibleItems;
        _visibleVerifiedItems = visibleItems
            .Where(item => item.VerificationState == PremiereVerificationState.Verified)
            .ToArray();
        _visibleUnverifiedItems = visibleItems
            .Where(item => item.VerificationState == PremiereVerificationState.Unverified)
            .ToArray();
        _partitionVisibleCount = HashCode.Combine(_windowStart, _visibleCount);
    }

    private static string FormatCount(int count, string noun)
    {
        if (noun == "series")
        {
            return $"{count} series";
        }

        return count == 1 ? $"1 {noun}" : $"{count} {noun}s";
    }

    private string BuildRenderFingerprint()
    {
        return string.Create(
            CultureInfo.InvariantCulture,
            $"{_itemsSignature}|{WindowScope}|{ScoreSource}|{ImageCacheVersion}|{RefreshImageCache}|{InitialVisibleCount}|{LoadBatchSize}|{MaxMountedItemCount}|{_windowStart}|{_visibleCount}|{_trimmedHeightPx}|{IntegrationSettings.Sonarr.Enabled}|{IntegrationSettings.Radarr.Enabled}|{IsArrActionBusy}");
    }

    private string BuildItemsSignature()
    {
        var hash = new HashCode();
        hash.Add(Day);
        hash.Add(Items.Count);

        foreach (var item in Items)
        {
            AppendItemSignature(ref hash, item);
        }

        return hash.ToHashCode().ToString(CultureInfo.InvariantCulture);
    }

    private static void AppendItemSignature(ref HashCode hash, PremiereItem item)
    {
        hash.Add(item.CanonicalId);
        hash.Add(item.Type);
        hash.Add(item.MediaType);
        hash.Add(item.TmdbId);
        hash.Add(item.VerificationState);
        hash.Add(item.VerificationNote);
        hash.Add(item.ExternalUrl);
        hash.Add(item.Title);
        hash.Add(item.PremiereDate);
        hash.Add(item.SeasonNumber);
        hash.Add(item.EpisodeNumber);
        hash.Add(item.EpisodeTitle);
        hash.Add(item.PosterUrl);
        hash.Add(item.ImageSource);
        hash.Add(item.Overview);
        hash.Add(item.OriginalLanguage);
        hash.Add(item.RuntimeMinutes);
        hash.Add(item.TmdbScore);
        hash.Add(item.TmdbVoteCount);
        hash.Add(item.ImdbScore);
        hash.Add(item.ImdbVoteCount);
        hash.Add(item.RottenTomatoesScore);
        hash.Add(item.RottenTomatoesAudienceScore);
        hash.Add(item.MetacriticScore);
        hash.Add(item.TvmazeRating);
        hash.Add(item.TrailerUrl);
        hash.Add(item.TmdbUrl);
        hash.Add(item.ImdbUrl);
        hash.Add(item.TvmazeUrl);
        hash.Add(item.OfficialSiteUrl);
        hash.Add(item.EpisodeSource);
        hash.Add(item.LastUpdatedUtc);
        AddValues(ref hash, item.OriginCountries);
        AddValues(ref hash, item.SourceNames);
        AddValues(ref hash, item.Genres);
    }

    private static void AddValues(ref HashCode hash, IEnumerable<string> values)
    {
        foreach (var value in values)
        {
            hash.Add(value, StringComparer.Ordinal);
        }
    }

    private sealed record WindowSlice(int ItemCount, double HeightPx);
}
