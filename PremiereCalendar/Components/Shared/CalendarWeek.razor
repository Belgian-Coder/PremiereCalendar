@using System.Globalization
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="calendar-week-board">
    <div class="week-sticky-controls">
        <div class="week-day-row">
            <button class="filter-open-button"
                    type="button"
                    title="Open filters"
                    aria-label="Open filters"
                    @onclick="OnOpenFilters">
                <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                    <path d="M4 5h16l-6.2 7.1v5.1l-3.6 1.8v-6.9L4 5Z" />
                </svg>
                <span class="visually-hidden">Filters</span>
            </button>

            <nav class="day-jump-nav" aria-label="Week days" role="tablist">
                @for (var index = 0; index < 7; index++)
                {
                    var day = WeekStart.AddDays(index);
                    <button class="@DayButtonClass(day)"
                            id="@DayButtonId(day)"
                            type="button"
                            role="tab"
                            data-day-button
                            data-day-target="@DayElementId(day)"
                            aria-label="@DayButtonAriaLabel(day)"
                            aria-selected="@AriaSelected(day)"
                            tabindex="@DayTabIndex(day)"
                            aria-controls="@ControlledPanelId(day)"
                            @onkeydown="args => OnDayKeyDown(args, day)"
                            @onclick="() => SelectDay(day)">
                        <span class="day-jump-main">
                            <span>@day.ToString("ddd", CultureInfo.CurrentCulture)</span>
                            <span>@day.ToString("dd MMM", CultureInfo.CurrentCulture)</span>
                        </span>
                        <small class="day-jump-count">@DayCountLabel(day)</small>
                    </button>
                }
            </nav>
        </div>
    </div>

    <div class="calendar-grid" data-testid="calendar-week" @ref="_selectedDayContainer">
        <CalendarDay @key="_selectedDay"
                     Day="_selectedDay"
                     DayId="@DayElementId(_selectedDay)"
                     LabelledById="@DayButtonId(_selectedDay)"
                     Items="SelectedDayItems"
                     ScoreSource="ScoreSource"
                     ImageCacheVersion="@ImageCacheVersion"
                     RefreshImageCache="RefreshImageCache"
                     InitialVisibleCount="InitialItemsPerDay"
                     LoadBatchSize="ItemsPerDayBatch"
                     IntegrationSettings="IntegrationSettings"
                     OnAddToArr="OnAddToArr"
                     IsArrActionBusy="IsArrActionBusy" />
    </div>
</div>

@code {
    [Parameter]
    public DateOnly WeekStart { get; set; }

    [Parameter]
    public IReadOnlyList<PremiereItem> Items { get; set; } = [];

    [Parameter]
    public ScoreSource ScoreSource { get; set; } = ScoreSource.Tmdb;

    [Parameter]
    public PremiereSortMode SortMode { get; set; } = PremiereSortMode.PremiereDate;

    [Parameter]
    public SortDirection SortDirection { get; set; } = SortDirection.Ascending;

    [Parameter]
    public string? ImageCacheVersion { get; set; }

    [Parameter]
    public bool RefreshImageCache { get; set; }

    [Parameter]
    public IntegrationSettings IntegrationSettings { get; set; } = new();

    [Parameter]
    public EventCallback<PremiereItem> OnAddToArr { get; set; }

    [Parameter]
    public bool IsArrActionBusy { get; set; }

    [Parameter]
    public int InitialItemsPerDay { get; set; } = 10;

    [Parameter]
    public int ItemsPerDayBatch { get; set; } = 10;

    [Parameter]
    public EventCallback OnOpenFilters { get; set; }

    [Parameter]
    public DateOnly? SelectedDay { get; set; }

    [Parameter]
    public EventCallback<DateOnly> OnSelectedDayChanged { get; set; }

    [Parameter]
    public EventCallback<DateOnly> OnAdjacentCalendarDayRequested { get; set; }

    private Dictionary<DateOnly, DayGroup> _dayGroups = [];
    private IReadOnlyList<PremiereItem>? _lastGroupedItems;
    private string _lastGroupKey = "";
    private DateOnly _selectedDay;
    private DateOnly _lastWeekStart;
    private ElementReference _selectedDayContainer;
    private DotNetObjectReference<CalendarWeek>? _objectReference;
    private bool _autoDayNavigationRegistered;
    private bool _hasUserSelectedDay;
    private bool _scrollSelectedDayIntoView;
    private bool _focusSelectedDayButton;

    private IReadOnlyList<PremiereItem> SelectedDayItems => _dayGroups.TryGetValue(_selectedDay, out var group) ? group.Items : [];

    protected override void OnParametersSet()
    {
        var weekChanged = _lastWeekStart != WeekStart;
        if (weekChanged)
        {
            _lastWeekStart = WeekStart;
            var externallySelectedDay = NormalizeSelectedDay(SelectedDay);
            _selectedDay = externallySelectedDay ?? WeekStart;
            _hasUserSelectedDay = externallySelectedDay.HasValue;
        }
        else if (NormalizeSelectedDay(SelectedDay) is { } externallySelectedDay
            && externallySelectedDay != _selectedDay)
        {
            _selectedDay = externallySelectedDay;
            _hasUserSelectedDay = true;
        }

        var groupKey = string.Create(
            CultureInfo.InvariantCulture,
            $"{WeekStart:yyyyMMdd}|{Items.Count}|{SortMode}|{SortDirection}|{ScoreSource}");

        if (ReferenceEquals(Items, _lastGroupedItems)
            && string.Equals(groupKey, _lastGroupKey, StringComparison.Ordinal))
        {
            return;
        }

        _lastGroupedItems = Items;
        _lastGroupKey = groupKey;
        _dayGroups = CreateDayGroups();

        if (_selectedDay == default
            || _selectedDay < WeekStart
            || _selectedDay > WeekStart.AddDays(6))
        {
            _selectedDay = WeekStart;
            _hasUserSelectedDay = false;
        }

        if (!_hasUserSelectedDay && SelectedDayItems.Count == 0)
        {
            _selectedDay = FirstDayWithItems() ?? WeekStart;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_autoDayNavigationRegistered)
        {
            _autoDayNavigationRegistered = true;
            _objectReference = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync(
                    "premiereCalendarWeek.registerAutoDayNavigation",
                    _selectedDayContainer,
                    _objectReference);
            }
            catch (InvalidOperationException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }

        if (_focusSelectedDayButton)
        {
            _focusSelectedDayButton = false;
            try
            {
                await JS.InvokeVoidAsync("premiereCalendarWeek.focusDayButton", DayElementId(_selectedDay));
            }
            catch (InvalidOperationException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }

        if (_scrollSelectedDayIntoView)
        {
            _scrollSelectedDayIntoView = false;
            try
            {
                await JS.InvokeVoidAsync("premiereCalendarWeek.scrollSelectedDayIntoView", _selectedDayContainer);
            }
            catch (InvalidOperationException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }
    }

    private Dictionary<DateOnly, DayGroup> CreateDayGroups()
    {
        var start = WeekStart;
        var end = start.AddDays(6);
        var groups = new Dictionary<DateOnly, DayGroupBuilder>();

        foreach (var item in Items)
        {
            if (item.PremiereDate < start || item.PremiereDate > end)
            {
                continue;
            }

            if (!groups.TryGetValue(item.PremiereDate, out var builder))
            {
                builder = new DayGroupBuilder();
                groups[item.PremiereDate] = builder;
            }

            builder.Add(item);
        }

        return groups.ToDictionary(entry => entry.Key, entry => entry.Value.ToDayGroup());
    }

    private static string DayElementId(DateOnly day)
    {
        return $"premiere-day-{day.ToString("yyyyMMdd", CultureInfo.InvariantCulture)}";
    }

    private static string DayButtonId(DateOnly day)
    {
        return $"premiere-day-tab-{day.ToString("yyyyMMdd", CultureInfo.InvariantCulture)}";
    }

    private string? ControlledPanelId(DateOnly day)
    {
        return day == _selectedDay ? DayElementId(day) : null;
    }

    private string DayButtonClass(DateOnly day)
    {
        return day == _selectedDay ? "day-jump-link active" : "day-jump-link";
    }

    private string AriaSelected(DateOnly day)
    {
        return day == _selectedDay ? "true" : "false";
    }

    private int DayTabIndex(DateOnly day)
    {
        return day == _selectedDay ? 0 : -1;
    }

    private string DayCountLabel(DateOnly day)
    {
        if (!_dayGroups.TryGetValue(day, out var group) || group.Items.Count == 0)
        {
            return "Empty";
        }

        return group.MovieCount switch
        {
            > 0 when group.SeriesCount > 0 => $"M {group.MovieCount.ToString(CultureInfo.InvariantCulture)} / S {group.SeriesCount.ToString(CultureInfo.InvariantCulture)}",
            > 0 => $"{group.MovieCount.ToString(CultureInfo.InvariantCulture)} movie{Plural(group.MovieCount)}",
            _ => $"{group.SeriesCount.ToString(CultureInfo.InvariantCulture)} series"
        };
    }

    private string DayButtonAriaLabel(DateOnly day)
    {
        if (!_dayGroups.TryGetValue(day, out var group) || group.Items.Count == 0)
        {
            return $"{day.ToString("dddd, dd MMMM yyyy", CultureInfo.CurrentCulture)}, no premieres";
        }

        var countText = new List<string>();
        if (group.MovieCount > 0)
        {
            countText.Add($"{group.MovieCount.ToString(CultureInfo.InvariantCulture)} movie{Plural(group.MovieCount)}");
        }

        if (group.SeriesCount > 0)
        {
            countText.Add($"{group.SeriesCount.ToString(CultureInfo.InvariantCulture)} series");
        }

        return $"{day.ToString("dddd, dd MMMM yyyy", CultureInfo.CurrentCulture)}, {string.Join(" and ", countText)}";
    }

    private static string Plural(int count)
    {
        return count == 1 ? "" : "s";
    }

    private async Task SelectDay(DateOnly day, bool focusSelectedDayButton = false)
    {
        _selectedDay = day;
        _hasUserSelectedDay = true;
        _scrollSelectedDayIntoView = true;
        _focusSelectedDayButton = focusSelectedDayButton;
        await OnSelectedDayChanged.InvokeAsync(day);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task SelectAdjacentDayByScrollAsync(int direction)
    {
        var normalizedDirection = Math.Sign(direction);
        if (normalizedDirection == 0)
        {
            return;
        }

        var nextDay = _selectedDay.AddDays(normalizedDirection);
        if (nextDay >= WeekStart && nextDay <= WeekStart.AddDays(6))
        {
            await SelectDay(nextDay, focusSelectedDayButton: true);
            return;
        }

        await OnAdjacentCalendarDayRequested.InvokeAsync(nextDay);
    }

    private async Task OnDayKeyDown(KeyboardEventArgs args, DateOnly day)
    {
        var nextDay = args.Key switch
        {
            "ArrowRight" => day.AddDays(1),
            "ArrowLeft" => day.AddDays(-1),
            "Home" => WeekStart,
            "End" => WeekStart.AddDays(6),
            _ => (DateOnly?)null
        };

        if (nextDay is not { } value)
        {
            return;
        }

        if (value < WeekStart || value > WeekStart.AddDays(6))
        {
            await OnAdjacentCalendarDayRequested.InvokeAsync(value);
            return;
        }

        await SelectDay(value, focusSelectedDayButton: true);
    }

    private DateOnly? FirstDayWithItems()
    {
        for (var index = 0; index < 7; index++)
        {
            var day = WeekStart.AddDays(index);
            if (_dayGroups.TryGetValue(day, out var group) && group.Items.Count > 0)
            {
                return day;
            }
        }

        return null;
    }

    private DateOnly? NormalizeSelectedDay(DateOnly? day)
    {
        return day is { } value && value >= WeekStart && value <= WeekStart.AddDays(6)
            ? value
            : null;
    }

    private sealed record DayGroup(
        IReadOnlyList<PremiereItem> Items,
        int MovieCount,
        int SeriesCount);

    private sealed class DayGroupBuilder
    {
        private readonly List<PremiereItem> _verifiedItems = [];
        private readonly List<PremiereItem> _unverifiedItems = [];
        private int _movieCount;

        public void Add(PremiereItem item)
        {
            if (item.MediaType == PremiereMediaType.Movie)
            {
                _movieCount++;
            }

            if (item.VerificationState == PremiereVerificationState.Unverified)
            {
                _unverifiedItems.Add(item);
            }
            else
            {
                _verifiedItems.Add(item);
            }
        }

        public DayGroup ToDayGroup()
        {
            var items = new List<PremiereItem>(_verifiedItems.Count + _unverifiedItems.Count);
            items.AddRange(_verifiedItems);
            items.AddRange(_unverifiedItems);
            return new DayGroup(items, _movieCount, items.Count - _movieCount);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("premiereCalendarWeek.disposeAutoDayNavigation", _selectedDayContainer);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        _objectReference?.Dispose();
    }
}
