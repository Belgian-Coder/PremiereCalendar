<div class="score-filter" data-testid="score-filter">
    <label>
        Minimum
        <input type="number"
               min="0"
               max="10"
               step="0.1"
               @bind="Filters.MinScore"
               @bind:after="NotifyChanged" />
    </label>

    <label>
        Maximum
        <input type="number"
               min="0"
               max="10"
               step="0.1"
               @bind="Filters.MaxScore"
               @bind:after="NotifyChanged" />
    </label>
</div>

@code {
    [Parameter, EditorRequired]
    public CalendarFilters Filters { get; set; } = new();

    [Parameter]
    public EventCallback OnFiltersChanged { get; set; }

    private Task NotifyChanged()
    {
        return OnFiltersChanged.InvokeAsync();
    }
}
