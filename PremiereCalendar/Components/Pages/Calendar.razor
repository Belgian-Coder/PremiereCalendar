@page "/"
@page "/series"
@page "/movies"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable
@inject IPremiereService PremiereService
@inject IAdjacentWeekPrefetcher AdjacentWeekPrefetcher
@inject CalendarPageCoordinator CalendarLoadCoordinator
@inject ICalendarFilterUsageStore CalendarFilterUsageStore
@inject IFilterCatalogService FilterCatalogService
@inject IIntegrationSettingsStore IntegrationSettingsStore
@inject IArrIntegrationService ArrIntegrationService
@inject IViewSyncService ViewSyncService
@inject ICalendarCacheMaintenance CalendarCacheMaintenance
@inject CalendarPresetService CalendarPresetService
@inject CalendarVisitChangeService CalendarVisitChangeService
@inject Microsoft.Extensions.Options.IOptions<PremiereCalendar.Options.CalendarLoadOptions> CalendarLoadOptions
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILogger<PremiereCalendar.Components.Pages.Calendar> Logger

<PageTitle>@PageTitleText()</PageTitle>

<ToastStack Messages="_toasts" />

<div class="calendar-shell">
    @{
        var activeFilterCount = ActiveFilterCount();
        var scopeBadgeText = CalendarScopeBadgeText();
        var hasVisibleItemsForCurrentWeek = HasVisibleItemsForCurrentWeek(_visibleItems);
        var visibleCacheFreshness = VisibleCacheFreshnessEntries();
    }

    <header class="calendar-command-bar" data-testid="calendar-command-bar">
        <h1 class="visually-hidden" tabindex="-1" data-testid="calendar-focus-target">@PageTitleText()</h1>

        <div class="calendar-command-summary">
            <span class="calendar-mode-pill">@CalendarModeLabel()</span>
            @if (!string.IsNullOrWhiteSpace(scopeBadgeText))
            {
                <span class="calendar-scope-pill">@scopeBadgeText</span>
            }
            <span class="command-week-range" data-testid="week-range">@CompactWeekRangeText()</span>
            <span class="calendar-result-count">@VisibleResultCountText()</span>
            @if (_isLoading && hasVisibleItemsForCurrentWeek)
            {
                <span class="calendar-refresh-status" data-testid="refreshing" aria-live="polite">
                    Updating visible premieres…
                </span>
            }

        </div>

        <div class="calendar-command-actions" aria-label="Calendar controls">
            <div class="button-group command-week-nav" role="group" aria-label="Week navigation">
                <button class="tool-button compact-command" title="Previous week" aria-label="Previous week" @onclick="PreviousWeek">
                    <span aria-hidden="true">&lt;</span>
                    <span class="button-label">Previous</span>
                </button>
                <button class="tool-button compact-command" title="This week" @onclick="CurrentWeek">This week</button>
                <button class="tool-button compact-command" title="Next week" aria-label="Next week" @onclick="NextWeek">
                    <span class="button-label">Next</span>
                    <span aria-hidden="true">&gt;</span>
                </button>
            </div>

            <div class="button-group refresh-mode-group" role="group" aria-label="Refresh mode">
                <button class="tool-button compact-command" title="Update visible week" aria-label="Update visible week" @onclick="QuickRefreshAsync" aria-busy="@_isLoading">
                    Update
                </button>
                <button class="tool-button primary-action compact-command full-refresh-command" title="Refresh sources from providers" aria-label="Refresh sources from providers" @onclick="RefreshAsync" aria-busy="@_isLoading">
                    Refresh sources
                </button>
            </div>

            <button class="tool-button compact-command"
                    type="button"
                    title="Open tools and actions (Ctrl+K)"
                    aria-label="Open tools and actions"
                    data-command-palette-toggle
                    aria-expanded="@AriaExpanded(_isCommandPaletteOpen)"
                    aria-controls="calendar-command-palette"
                    @onclick="ToggleCommandPalette">
                <span class="command-palette-label-full">Actions</span>
                <span class="command-palette-label-short" aria-hidden="true">Tools</span>
            </button>
        </div>

        @if (_isCommandPaletteOpen)
        {
            <section class="command-palette" id="calendar-command-palette" data-testid="command-palette" data-command-palette-panel aria-label="Actions">
                <button type="button" class="command-palette-item" @onclick="QuickRefreshFromCommandPaletteAsync">Update visible week</button>
                <button type="button" class="command-palette-item" @onclick="FullRefreshFromCommandPaletteAsync">Refresh sources</button>
                @if (HasQueryProgressEntries())
                {
                    <button type="button" class="command-palette-item" @onclick="ShowSourceDetailsFromCommandPalette">Source details</button>
                }
                <button type="button" class="command-palette-item" @onclick="OpenFilters">Filters</button>
                <button type="button" class="command-palette-item" @onclick="CurrentWeekFromCommandPaletteAsync">This week</button>
                <button type="button" class="command-palette-item" @onclick="OpenSettings">Settings</button>
                <button type="button" class="command-palette-item" aria-pressed="@_compactDensity" @onclick="ToggleDensityAsync">@(_compactDensity ? "Use comfortable cards" : "Use compact cards")</button>
                <div class="command-palette-export-actions" role="group" aria-label="Share or export the current filtered view">
                    <button type="button" class="command-palette-item" @onclick="ShareCurrentViewAsync">Copy view link</button>
                    <button type="button" class="command-palette-item" disabled="@(_visibleItems.Count == 0)" @onclick='() => ExportVisibleItemsAsync("ics")'>Export ICS</button>
                    <button type="button" class="command-palette-item" disabled="@(_visibleItems.Count == 0)" @onclick='() => ExportVisibleItemsAsync("csv")'>Export CSV</button>
                    <button type="button" class="command-palette-item" disabled="@(_visibleItems.Count == 0)" @onclick='() => ExportVisibleItemsAsync("json")'>Export JSON</button>
                </div>
                <div class="command-palette-presets" aria-label="Saved filter presets">
                    <strong>Saved filter presets</strong>
                    <input class="preset-name-input"
                           aria-label="Preset name"
                           placeholder="Preset name"
                           @bind="_presetName"
                           @bind:event="oninput" />
                    <div class="command-palette-preset-actions">
                        <button class="tool-button compact-command"
                                type="button"
                                title="Save current filters as preset"
                                @onclick="SavePresetAsync"
                                disabled="@_isSavingPreset">
                            Save preset
                        </button>
                        <select class="preset-select"
                                aria-label="Saved filter presets"
                                @bind="_selectedPresetId">
                            <option value="">Choose preset</option>
                            @foreach (var preset in _filterPresets)
                            {
                                <option value="@preset.Id">@preset.Name</option>
                            }
                        </select>
                        <button class="tool-button compact-command"
                                type="button"
                                title="Apply saved filter preset"
                                @onclick="ApplySelectedPresetAsync"
                                disabled="@string.IsNullOrWhiteSpace(_selectedPresetId)">
                            Apply preset
                        </button>
                    </div>
                </div>
            </section>
        }

        @if (ShouldShowQueryProgress())
        {
            <section class="@QueryProgressPanelClass()" data-testid="query-progress" aria-live="polite">
                <div class="query-progress-heading">
                    <div class="query-progress-summary">
                        <span>Sources</span>
                        <strong>@QueryProgressSummaryText()</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_sourceProgressFilter))
                    {
                        <button type="button"
                                class="query-progress-clear compact"
                                title="Show all loaded sources"
                                aria-label="Clear loaded-source filter"
                                data-focus-restore="calendar-heading"
                                @onclick="ClearSourceProgressFilterAsync">
                            Clear source
                        </button>
                    }
                    <button type="button"
                            class="query-progress-toggle"
                            title="@(_isQueryProgressExpanded ? "Hide loaded-source details" : "Show loaded-source details")"
                            aria-expanded="@AriaExpanded(_isQueryProgressExpanded)"
                            aria-controls="@QueryProgressDetailsId()"
                            data-testid="query-progress-toggle"
                            @onclick="ToggleQueryProgressDetails">
                        @(_isQueryProgressExpanded ? "Hide sources" : "Source details")
                    </button>
                </div>
                @if (_isQueryProgressExpanded)
                {
                    <div class="query-progress-list" id="query-progress-details" data-testid="query-progress-details">
                        @foreach (var entry in GroupedLoadProgressEntries())
                        {
                            <button type="button"
                                    class="@QueryProgressClass(entry)"
                                    title="@QueryProgressTitle(entry)"
                                    aria-pressed="@IsSourceProgressFilterActive(entry)"
                                    @onclick="() => ToggleSourceProgressFilter(entry)">
                                <span>@entry.SourceName</span>
                                <strong>@FormatSourceCardCount(entry.SourceItemCount)</strong>
                                @if (entry.UnmappedCount is > 0)
                                {
                                    <small class="query-progress-detail">@FormatUnmappedCount(entry.UnmappedCount.Value)</small>
                                }
                                @if (entry.TotalWork is > 0)
                                {
                                    <span class="query-progress-meter"
                                          role="progressbar"
                                          aria-label="@($"{entry.SourceName} loading progress")"
                                          aria-valuemin="0"
                                          aria-valuemax="100"
                                          aria-valuenow="@QueryProgressPercent(entry)"
                                          data-testid="query-progress-bar">
                                        <span style="@($"width: {QueryProgressWidth(entry)}")"></span>
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.ProgressText))
                                {
                                    <small class="query-progress-detail">@entry.ProgressText</small>
                                }
                                @if (entry.ElapsedMilliseconds is > 0)
                                {
                                    <small class="query-progress-detail">@FormatElapsed(entry.ElapsedMilliseconds.Value)</small>
                                }
                            </button>
                        }

                        @if (!string.IsNullOrWhiteSpace(_sourceProgressFilter))
                        {
                            <button type="button"
                                    class="query-progress-clear"
                                    title="Show all loaded sources"
                                    data-focus-restore="calendar-heading"
                                    @onclick="ClearSourceProgressFilterAsync">
                                All loaded sources
                            </button>
                        }
                    </div>
                }
            </section>
        }

        @if (visibleCacheFreshness.Count > 0 || ShouldShowVisitChangeSummary())
        {
            <section class="@DataFreshnessCardClass(visibleCacheFreshness)" data-testid="data-freshness-card" aria-label="Visible week data freshness">
                @foreach (var entry in visibleCacheFreshness)
                {
                    <span class="@CacheFreshnessClass(entry)">
                        <strong>@entry.Label cache</strong>
                        <span>@CacheFreshnessText(entry)</span>
                    </span>
                }
                @if (ShouldShowVisitChangeSummary())
                {
                    <span class="visit-change-pill" data-testid="visit-change-summary">
                        @VisitChangeText()
                    </span>
                }
            </section>
        }
    </header>

    @if (_queuedViewSyncState is not null)
    {
        <section class="status-panel refreshing" data-testid="view-sync-queued" aria-live="polite">
            <span>Synced view available from @_queuedViewSyncState.UpdatedByDeviceName.</span>
            <button class="tool-button primary-action" type="button" @onclick="ApplyQueuedViewSyncAsync">Open synced view</button>
            <button class="tool-button" type="button" @onclick="DismissQueuedViewSync">Stay here</button>
        </section>
    }

    @if (_isFilterPaneOpen)
    {
        <CalendarFilterDialog PageMode="_pageMode"
                              Filters="_filters"
                              Catalog="_filterCatalog"
                              Items="_items"
                              OnSave="SaveFilters"
                              OnClose="CloseFilters" />
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="status-panel error" role="alert" data-testid="error">@_error</div>
    }
    else if (_isLoading && !hasVisibleItemsForCurrentWeek)
    {
        <div class="status-panel" data-testid="loading" role="status" aria-live="polite">Loading premieres for the selected week… Empty days will appear after loading completes.</div>
    }
    else
    {
        <CalendarWeek WeekStart="_filters.WeekStart"
                      WindowScope="@_pageMode.ToString()"
                      Items="_visibleItems"
                      ScoreSource="_filters.ScoreSource"
                      SortMode="_filters.SortMode"
                      SortDirection="_filters.SortDirection"
                      PreserveItemOrder="_preserveStreamedItemOrder"
                      ImageCacheVersion="@_imageCacheVersion"
                      RefreshImageCache="_refreshImageCache"
                      OnOpenFilters="OpenFilters"
                      ActiveFilterCount="@activeFilterCount"
                      SelectedDay="_selectedDay"
                      OnSelectedDayChanged="OnSelectedDayChanged"
                      OnAdjacentCalendarDayRequested="NavigateToCalendarDayAsync"
                      IntegrationSettings="_integrationSettings"
                      OnAddToArr="AddToArrAsync"
                      IsArrActionBusy="_arrAddInProgress.Count > 0"
                      IsUpdating="_isLoading" />
    }
</div>
