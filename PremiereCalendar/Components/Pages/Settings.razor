@page "/settings"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@inject IIntegrationSettingsStore SettingsStore
@inject IArrIntegrationService ArrService
@inject ISimklClient SimklClient
@inject IViewSyncService ViewSyncService
@inject IJSRuntime JS

<PageTitle>Settings</PageTitle>

<ToastStack Messages="_toasts" />

<div class="settings-shell">
    <header class="calendar-header">
        <div>
            <p class="eyebrow">Local integrations</p>
            <h1>Settings</h1>
        </div>
    </header>

    @if (_isLoading)
    {
        <div class="status-panel">Loading settings...</div>
    }
    else
    {
        <EditForm EditContext="_editContext">
            <section class="settings-grid">
                <article class="settings-panel" aria-label="View sync settings">
                    <div class="settings-panel-header">
                        <div>
                            <p class="eyebrow">Experience</p>
                            <h2>View sync</h2>
                            <div class="settings-status-row compact" aria-label="View sync status">
                                @StatusBadge("View sync", ViewSyncProviderStatus())
                            </div>
                        </div>
                        <label class="switch-row">
                            <input type="checkbox"
                                   aria-label="Sync viewing on this browser"
                                   @bind="_viewSyncEnabled"
                                   disabled="@(!_viewSyncLoaded)" />
                            <span>Sync this browser</span>
                        </label>
                    </div>

                    @if (!_viewSyncLoaded)
                    {
                        <div class="status-panel">Loading view sync...</div>
                    }
                    else
                    {
                        <div class="settings-fields">
                            <label>
                                <span>This device name</span>
                                <input class="settings-input"
                                       aria-label="This device name"
                                       @bind="_viewSyncDeviceName" />
                                <small class="settings-help">Use a friendly name like Office PC or Living room tablet.</small>
                            </label>

                            <label>
                                <span>View sync group</span>
                                <select class="settings-input"
                                        aria-label="View sync group"
                                        @bind="_selectedViewSyncGroupId">
                                    <option value="">No group</option>
                                    @foreach (var group in _viewSyncGroups)
                                    {
                                        <option value="@group.GroupId">@group.Name</option>
                                    }
                                </select>
                                <small class="settings-help">Devices in the same group follow the latest calendar URL.</small>
                            </label>

                            <div class="settings-inline-fields">
                                <label>
                                    <span>New group</span>
                                    <input class="settings-input"
                                           aria-label="New view sync group name"
                                           @bind="_newViewSyncGroupName" />
                                </label>
                                <button class="tool-button settings-secondary"
                                        type="button"
                                        aria-label="Create view sync group"
                                        @onclick="CreateViewSyncGroupAsync"
                                        disabled="@_isCreatingViewSyncGroup">
                                    @(_isCreatingViewSyncGroup ? "Creating..." : "Create group")
                                </button>
                            </div>

                            @if (_viewSyncGroupState is not null)
                            {
                                <div class="settings-selected-note" aria-label="Latest synced view">
                                    <span>Latest: @_viewSyncGroupState.RelativeUrl</span>
                                    <span>By @_viewSyncGroupState.UpdatedByDeviceName</span>
                                </div>
                            }

                            @if (_viewSyncGroupDevices.Count > 0)
                            {
                                <div class="settings-options-list" aria-label="Devices in view sync group">
                                    @foreach (var device in _viewSyncGroupDevices)
                                    {
                                        <span>
                                            @device.DisplayName
                                            @if (IsCurrentViewSyncDevice(device))
                                            {
                                                <strong class="view-sync-me-badge" data-testid="view-sync-me-badge">me</strong>
                                            }
                                            · @FormatViewSyncLastSeen(device.LastSeenUtc)
                                        </span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="settings-action-row">
                            <button class="tool-button primary-action"
                                    type="button"
                                    aria-label="Save view sync settings"
                                    @onclick="SaveViewSyncSettingsAsync"
                                    disabled="@_isSavingViewSync">
                                @ViewSyncSaveButtonText
                            </button>
                            <button class="tool-button settings-secondary"
                                    type="button"
                                    aria-label="Ungroup this device"
                                    @onclick="UngroupViewSyncDeviceAsync"
                                    disabled="@(_isUngroupingViewSync || string.IsNullOrWhiteSpace(_viewSyncOverview?.Device.GroupId))">
                                @(_isUngroupingViewSync ? "Ungrouping..." : "Ungroup this device")
                            </button>
                        </div>
                    }
                </article>

                <article class="settings-panel">
                    <div class="settings-panel-header">
                        <div>
                            <p class="eyebrow">Series</p>
                            <h2>Sonarr</h2>
                            <div class="settings-status-row compact" aria-label="Library app integration status">
                                @StatusBadge("Sonarr", SonarrProviderStatus())
                            </div>
                        </div>
                        <label class="switch-row">
                            <InputCheckbox @bind-Value="_settings.Sonarr.Enabled" />
                            <span>Enabled</span>
                        </label>
                    </div>

                    <div class="settings-fields">
                        <label>
                            <span>URL</span>
                            <InputText class="settings-input" aria-label="Sonarr URL" @bind-Value="_settings.Sonarr.BaseUrl" />
                        </label>

                        <label>
                            <span>API key</span>
                            <InputText type="password" class="settings-input" aria-label="Sonarr API key" @bind-Value="_settings.Sonarr.ApiKey" />
                        </label>

                        <label>
                            <span>Tag on add</span>
                            <InputText class="settings-input" aria-label="Sonarr tag on add" @bind-Value="_settings.Sonarr.TagOnAdd" />
                            <small class="settings-help">Created if missing. Leave empty to add without a tag.</small>
                        </label>

                        <label>
                            <span>Root folder path</span>
                            <InputText class="settings-input" list="sonarr-root-folders" aria-label="Sonarr root folder path" @bind-Value="_settings.Sonarr.RootFolderPath" />
                            <datalist id="sonarr-root-folders">
                                @foreach (var root in _sonarrOptions.RootFolders)
                                {
                                    <option value="@root.Path">@root.Path</option>
                                }
                            </datalist>
                        </label>

                        @if (_sonarrOptions.QualityProfiles.Count > 0)
                        {
                            <label>
                                <span>Quality profile</span>
                                <select class="settings-input" aria-label="Sonarr quality profile" @bind="_settings.Sonarr.QualityProfileId">
                                    <option value="">Select a profile</option>
                                    @if (_settings.Sonarr.QualityProfileId is > 0
                                                                    && !_sonarrOptions.QualityProfiles.Any(profile => profile.Id == _settings.Sonarr.QualityProfileId.Value))
                                    {
                                        <option value="@_settings.Sonarr.QualityProfileId.Value">Current ID @_settings.Sonarr.QualityProfileId.Value</option>
                                    }
                                    @foreach (var profile in _sonarrOptions.QualityProfiles)
                                    {
                                        <option value="@profile.Id">@profile.Name</option>
                                    }
                                </select>
                            </label>
                        }
                        else
                        {
                            <label>
                                <span>Quality profile ID</span>
                                <InputNumber class="settings-input" aria-label="Sonarr quality profile ID" @bind-Value="_settings.Sonarr.QualityProfileId" />
                                <small class="settings-help">Load Sonarr options to select by profile name.</small>
                            </label>
                        }

                        @if (_sonarrOptions.QualityProfiles.Count > 0)
                        {
                            <div class="settings-selected-note" aria-label="Selected Sonarr quality profile">
                                @foreach (var profile in _sonarrOptions.QualityProfiles)
                                {
                                    @if (_settings.Sonarr.QualityProfileId == profile.Id)
                                    {
                                        <span>Selected: @profile.Name</span>
                                    }
                                }
                            </div>
                        }

                        <label>
                            <span>Series type</span>
                            <select class="settings-input" aria-label="Sonarr series type" @bind="_settings.Sonarr.SeriesType">
                                <option value="standard">Standard</option>
                                <option value="daily">Daily</option>
                                <option value="anime">Anime</option>
                            </select>
                        </label>

                        <label>
                            <span>Monitor</span>
                            <select class="settings-input" aria-label="Sonarr monitor mode" @bind="_settings.Sonarr.Monitor">
                                <option value="all">All episodes</option>
                                <option value="future">Future episodes</option>
                                <option value="missing">Missing episodes</option>
                                <option value="existing">Existing episodes</option>
                                <option value="firstSeason">First season</option>
                                <option value="latestSeason">Latest season</option>
                                <option value="none">None</option>
                            </select>
                        </label>

                        <label class="switch-row">
                            <InputCheckbox @bind-Value="_settings.Sonarr.SeasonFolder" />
                            <span>Use season folders</span>
                        </label>

                        <label class="switch-row">
                            <InputCheckbox @bind-Value="_settings.Sonarr.SearchOnAdd" />
                            <span>Search for missing episodes after add</span>
                        </label>
                    </div>

                    <button class="tool-button settings-secondary" type="button" aria-label="Load Sonarr quality profiles and root folders" @onclick="LoadSonarrOptionsAsync" disabled="@_isLoadingSonarr">
                        @(_isLoadingSonarr ? "Loading Sonarr..." : "Load Sonarr options")
                    </button>
                </article>

                <article class="settings-panel">
                    <div class="settings-panel-header">
                        <div>
                            <p class="eyebrow">Movies</p>
                            <h2>Radarr</h2>
                            <div class="settings-status-row compact" aria-label="Library app integration status">
                                @StatusBadge("Radarr", RadarrProviderStatus())
                            </div>
                        </div>
                        <label class="switch-row">
                            <InputCheckbox @bind-Value="_settings.Radarr.Enabled" />
                            <span>Enabled</span>
                        </label>
                    </div>

                    <div class="settings-fields">
                        <label>
                            <span>URL</span>
                            <InputText class="settings-input" aria-label="Radarr URL" @bind-Value="_settings.Radarr.BaseUrl" />
                        </label>

                        <label>
                            <span>API key</span>
                            <InputText type="password" class="settings-input" aria-label="Radarr API key" @bind-Value="_settings.Radarr.ApiKey" />
                        </label>

                        <label>
                            <span>Tag on add</span>
                            <InputText class="settings-input" aria-label="Radarr tag on add" @bind-Value="_settings.Radarr.TagOnAdd" />
                            <small class="settings-help">Created if missing. Leave empty to add without a tag.</small>
                        </label>

                        <label>
                            <span>Root folder path</span>
                            <InputText class="settings-input" list="radarr-root-folders" aria-label="Radarr root folder path" @bind-Value="_settings.Radarr.RootFolderPath" />
                            <datalist id="radarr-root-folders">
                                @foreach (var root in _radarrOptions.RootFolders)
                                {
                                    <option value="@root.Path">@root.Path</option>
                                }
                            </datalist>
                        </label>

                        @if (_radarrOptions.QualityProfiles.Count > 0)
                        {
                            <label>
                                <span>Quality profile</span>
                                <select class="settings-input" aria-label="Radarr quality profile" @bind="_settings.Radarr.QualityProfileId">
                                    <option value="">Select a profile</option>
                                    @if (_settings.Radarr.QualityProfileId is > 0
                                                                    && !_radarrOptions.QualityProfiles.Any(profile => profile.Id == _settings.Radarr.QualityProfileId.Value))
                                    {
                                        <option value="@_settings.Radarr.QualityProfileId.Value">Current ID @_settings.Radarr.QualityProfileId.Value</option>
                                    }
                                    @foreach (var profile in _radarrOptions.QualityProfiles)
                                    {
                                        <option value="@profile.Id">@profile.Name</option>
                                    }
                                </select>
                            </label>
                        }
                        else
                        {
                            <label>
                                <span>Quality profile ID</span>
                                <InputNumber class="settings-input" aria-label="Radarr quality profile ID" @bind-Value="_settings.Radarr.QualityProfileId" />
                                <small class="settings-help">Load Radarr options to select by profile name.</small>
                            </label>
                        }

                        @if (_radarrOptions.QualityProfiles.Count > 0)
                        {
                            <div class="settings-selected-note" aria-label="Selected Radarr quality profile">
                                @foreach (var profile in _radarrOptions.QualityProfiles)
                                {
                                    @if (_settings.Radarr.QualityProfileId == profile.Id)
                                    {
                                        <span>Selected: @profile.Name</span>
                                    }
                                }
                            </div>
                        }

                        <label>
                            <span>Minimum availability</span>
                            <select class="settings-input" aria-label="Radarr minimum availability" @bind="_settings.Radarr.MinimumAvailability">
                                <option value="announced">Announced</option>
                                <option value="inCinemas">In cinemas</option>
                                <option value="released">Released</option>
                                <option value="preDB">PreDB</option>
                            </select>
                        </label>

                        <label class="switch-row">
                            <InputCheckbox @bind-Value="_settings.Radarr.Monitored" />
                            <span>Monitor movie</span>
                        </label>

                        <label class="switch-row">
                            <InputCheckbox @bind-Value="_settings.Radarr.SearchOnAdd" />
                            <span>Search for movie after add</span>
                        </label>
                    </div>

                    <button class="tool-button settings-secondary" type="button" aria-label="Load Radarr quality profiles and root folders" @onclick="LoadRadarrOptionsAsync" disabled="@_isLoadingRadarr">
                        @(_isLoadingRadarr ? "Loading Radarr..." : "Load Radarr options")
                    </button>
                </article>

                <article class="settings-panel">
                    <div class="settings-panel-header">
                        <div>
                            <p class="eyebrow">Metadata sources</p>
                            <h2>Source APIs</h2>
                        </div>
                    </div>

                    <div class="settings-fields">
                        <section class="settings-provider-group" aria-label="Movie and series provider settings">
                            <div class="settings-provider-group-header">
                                <div>
                                    <p class="eyebrow">Calendar discovery</p>
                                    <h3>Movie and series providers</h3>
                                </div>
                                <div class="settings-status-row">
                                    @StatusBadge("TMDb", TmdbProviderStatus())
                                    @StatusBadge("TVmaze", TvmazeProviderStatus())
                                    @StatusBadge("Trakt", TraktProviderStatus())
                                </div>
                            </div>

                            <label>
                                <span>TMDb API read access token</span>
                                <InputText type="password" class="settings-input" aria-label="TMDb API read access token" @bind-Value="_settings.Sources.Tmdb.BearerToken" />
                                <small class="settings-help">Required for live calendar data.</small>
                            </label>

                            <label class="switch-row">
                                <InputCheckbox @bind-Value="_settings.Sources.Tvmaze.Enabled" />
                                <span>Enable TVmaze enrichment</span>
                            </label>

                            <label class="switch-row">
                                <InputCheckbox @bind-Value="_settings.Sources.Tvmaze.EnableScheduleDiscovery" />
                                <span>Enable TVmaze schedule discovery</span>
                            </label>

                            <label>
                                <span>TVmaze schedule countries</span>
                                <InputText class="settings-input" aria-label="TVmaze schedule countries" @bind-Value="_tvmazeScheduleCountries" />
                                <small class="settings-help">Comma-separated country codes, for example BE, US, GB, AU. Leave empty for global web schedules only.</small>
                            </label>

                            <label class="switch-row">
                                <InputCheckbox @bind-Value="_settings.Sources.Trakt.Enabled" />
                                <span>Enable Trakt calendar candidates</span>
                            </label>

                            <label>
                                <span>Trakt client ID</span>
                                <InputText type="password" class="settings-input" aria-label="Trakt client ID" @bind-Value="_settings.Sources.Trakt.ClientId" />
                                <small class="settings-help">Only the client ID is needed for the public calendar endpoints.</small>
                            </label>

                        </section>

                        <section class="settings-provider-group" aria-label="Watch availability provider settings">
                            <div class="settings-provider-group-header">
                                <div>
                                    <p class="eyebrow">Streaming sources</p>
                                    <h3>Watch availability</h3>
                                </div>
                                <div class="settings-status-row">
                                    @StatusBadge("Watchmode availability", WatchmodeAvailabilityProviderStatus())
                                </div>
                            </div>

                            <label class="switch-row">
                                <InputCheckbox @bind-Value="_settings.Sources.Watchmode.Enabled" />
                                <span>Enable Watchmode availability</span>
                            </label>

                            <label>
                                <span>Watchmode API key</span>
                                <InputText type="password" class="settings-input" aria-label="Watchmode API key" @bind-Value="_settings.Sources.Watchmode.ApiKey" />
                                <small class="settings-help">Used only as a fallback for streaming availability when TMDb has no provider data.</small>
                            </label>

                            <label class="switch-row">
                                <InputCheckbox @bind-Value="_settings.Sources.Watchmode.EnableAvailabilityEnrichment" />
                                <span>Enable Watchmode availability fallback</span>
                            </label>

                            <label>
                                <span>Watchmode regions</span>
                                <InputText class="settings-input" aria-label="Watchmode regions" @bind-Value="_watchmodeRegions" />
                                <small class="settings-help">Comma-separated country codes. Used when TMDb has no watch providers.</small>
                            </label>
                        </section>

                        <section class="settings-provider-group" aria-label="Sync provider settings">
                            <div class="settings-provider-group-header">
                                <div>
                                    <p class="eyebrow">Watch state</p>
                                    <h3>Sync provider</h3>
                                </div>
                                <div class="settings-status-row">
                                    @StatusBadge("SIMKL", SimklProviderStatus())
                                </div>
                            </div>

                            <label class="switch-row">
                                <InputCheckbox @bind-Value="_settings.Sources.Simkl.Enabled" />
                                <span>Enable SIMKL sync state</span>
                            </label>

                            <label>
                                <span>SIMKL client ID</span>
                                <InputText type="password" class="settings-input" aria-label="SIMKL client ID" @bind-Value="_settings.Sources.Simkl.ClientId" />
                            </label>

                            <label>
                                <span>SIMKL client secret</span>
                                <InputText type="password" class="settings-input" aria-label="SIMKL client secret" @bind-Value="_settings.Sources.Simkl.ClientSecret" />
                            </label>

                            <div class="simkl-connect" aria-label="SIMKL connection">
                                <div class="simkl-connect-header">
                                    <div>
                                        <span class="simkl-connect-title">SIMKL account</span>
                                        <small class="settings-help">@SimklConnectionSummary</small>
                                    </div>
                                    <span class="simkl-status @SimklStatusClass">@SimklStatusText</span>
                                </div>

                                <button class="tool-button primary-action settings-secondary" type="button" aria-label="Connect SIMKL" @onclick="ConnectSimklAsync" disabled="@_isRequestingSimklPin">
                                    @(_isRequestingSimklPin ? "Starting SIMKL..." : SimklConnectButtonText)
                                </button>

                                @if (_simklPinCode is { Success: true } simklPinCode)
                                {
                                    <div class="simkl-pin-panel" aria-label="SIMKL authorization code">
                                        <div class="simkl-pin-row">
                                            <span class="simkl-pin-label">Code</span>
                                            <strong class="simkl-pin-code">@simklPinCode.UserCode</strong>
                                            <a class="tool-button settings-secondary simkl-pin-link" href="@simklPinCode.VerificationUrl" target="_blank" rel="noopener">Open SIMKL authorization page</a>
                                        </div>
                                        <small class="settings-help">After you approve the app on SIMKL, this page will save the token automatically. Use the button below if it has not updated yet.</small>
                                        <button class="tool-button settings-secondary" type="button" aria-label="Save SIMKL token after authorization" @onclick="SaveSimklTokenAfterAuthorizationAsync" disabled="@_isCheckingSimklPin">
                                            @(_isCheckingSimklPin ? "Checking SIMKL..." : "I authorized SIMKL - save token")
                                        </button>
                                    </div>
                                }
                            </div>

                            <label>
                                <span>SIMKL access token</span>
                                <InputText type="password" class="settings-input" aria-label="SIMKL access token" @bind-Value="_settings.Sources.Simkl.AccessToken" />
                                <small class="settings-help">Continuous sync remains idle until an OAuth access token is saved.</small>
                            </label>

                            <label>
                                <span>SIMKL activity check interval</span>
                                <InputNumber class="settings-input" aria-label="SIMKL activity check interval minutes" @bind-Value="_settings.Sources.Simkl.MinimumActivityCheckMinutes" />
                                <small class="settings-help">Recommended: 30 minutes. This only checks SIMKL activity before a sync; it is not a background polling timer.</small>
                            </label>
                        </section>

                        <section class="settings-provider-group" aria-label="Score provider settings">
                            <div class="settings-provider-group-header">
                                <div>
                                    <p class="eyebrow">Ratings</p>
                                    <h3>Score provider</h3>
                                </div>
                                <div class="settings-status-row">
                                    @StatusBadge("OMDb", OmdbProviderStatus())
                                </div>
                            </div>

                            <label class="switch-row">
                                <InputCheckbox @bind-Value="_settings.Sources.Omdb.Enabled" />
                                <span>Enable OMDb ratings</span>
                            </label>

                            <label>
                                <span>OMDb API key</span>
                                <InputText type="password" class="settings-input" aria-label="OMDb API key" @bind-Value="_settings.Sources.Omdb.ApiKey" />
                            </label>
                        </section>

                        <section class="settings-provider-group" aria-label="Artwork provider settings">
                            <div class="settings-provider-group-header">
                                <div>
                                    <p class="eyebrow">Posters and covers</p>
                                    <h3>Artwork providers</h3>
                                </div>
                                <div class="settings-status-row">
                                    @StatusBadge("Fanart.tv", FanartProviderStatus())
                                    @StatusBadge("TheTVDB", TheTvdbProviderStatus())
                                    @StatusBadge("Wikimedia", WikimediaProviderStatus())
                                </div>
                            </div>

                            <label class="switch-row">
                                <InputCheckbox @bind-Value="_settings.Sources.Fanart.Enabled" />
                                <span>Enable Fanart.tv artwork</span>
                            </label>

                            <label>
                                <span>Fanart.tv API key</span>
                                <InputText type="password" class="settings-input" aria-label="Fanart.tv API key" @bind-Value="_settings.Sources.Fanart.ApiKey" />
                            </label>

                            <label class="switch-row">
                                <InputCheckbox @bind-Value="_settings.Sources.TheTvdb.Enabled" />
                                <span>Enable TheTVDB artwork</span>
                            </label>

                            <label>
                                <span>TheTVDB API key</span>
                                <InputText type="password" class="settings-input" aria-label="TheTVDB API key" @bind-Value="_settings.Sources.TheTvdb.ApiKey" />
                            </label>

                            <label class="switch-row">
                                <InputCheckbox @bind-Value="_settings.Sources.Wikimedia.Enabled" />
                                <span>Enable Wikimedia/Commons fallback</span>
                            </label>
                        </section>
                    </div>
                </article>
            </section>

            <div class="settings-actions sticky" aria-live="polite">
                <span class="@SettingsDirtyClass">@SettingsDirtyText</span>
                <button class="tool-button primary-action" type="button" title="Save integration settings" @onclick="SaveAsync" disabled="@_isSaving">
                    @(_isSaving ? "Saving..." : "Save settings")
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    private IntegrationSettings _settings = new();
    private ArrConnectionOptions _sonarrOptions = new([], []);
    private ArrConnectionOptions _radarrOptions = new([], []);
    private readonly List<ToastMessage> _toasts = [];
    private string _tvmazeScheduleCountries = "";
    private string _watchmodeRegions = "";
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isLoadingSonarr;
    private bool _isLoadingRadarr;
    private bool _isRequestingSimklPin;
    private bool _isCheckingSimklPin;
    private SimklPinCodeResult? _simklPinCode;
    private string? _simklAuthorizationStatus;
    private CancellationTokenSource? _simklPinPollingCancellation;
    private readonly CancellationTokenSource _disposeCancellation = new();
    private EditContext? _editContext;
    private bool _isDirty;
    private bool _viewSyncLoaded;
    private bool _viewSyncEnabled;
    private bool _isSavingViewSync;
    private bool _isCreatingViewSyncGroup;
    private bool _isUngroupingViewSync;
    private string _viewSyncDeviceId = "";
    private string _viewSyncDeviceName = "This browser";
    private string? _selectedViewSyncGroupId;
    private string _newViewSyncGroupName = "";
    private ViewSyncOverview? _viewSyncOverview;
    private IReadOnlyList<ViewSyncGroup> _viewSyncGroups = [];
    private IReadOnlyList<ViewSyncDevice> _viewSyncGroupDevices = [];
    private ViewSyncGroupState? _viewSyncGroupState;

    private bool HasSimklAccessToken => !string.IsNullOrWhiteSpace(_settings.Sources.Simkl.AccessToken);

    private string SimklConnectButtonText => HasSimklAccessToken ? "Reconnect SIMKL" : "Connect SIMKL";

    private string SettingsDirtyText => _isDirty ? "Unsaved changes" : "All changes saved";

    private string SettingsDirtyClass => _isDirty ? "settings-dirty dirty" : "settings-dirty clean";

    private string ViewSyncSaveButtonText
    {
        get
        {
            if (_isSavingViewSync)
            {
                return "Saving...";
            }

            return !_viewSyncEnabled && !string.IsNullOrWhiteSpace(_selectedViewSyncGroupId)
                ? "Add this browser"
                : "Save view sync";
        }
    }

    private string SimklConnectionSummary
    {
        get
        {
            if (_simklPinCode is not null)
            {
                return "Open SIMKL, enter the code, and leave this page open while it saves the token.";
            }

            return HasSimklAccessToken
                ? "Access token saved locally. Reconnect only if SIMKL access stops working."
