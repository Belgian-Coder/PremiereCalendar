<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>e9fb65ab-fad7-4bf7-9c12-b076a6fc56a5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="11.0.0-rc.3.26522.148" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="[15.0.0]" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PremiereCalendar.UnitTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PremiereCalendar.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DatabaseSchemaVersion</_Parameter1>
      <_Parameter2>$(DatabaseSchemaVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SourceRevisionId</_Parameter1>
      <_Parameter2>$(SourceRevisionId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildId</_Parameter1>
      <_Parameter2>$(BuildId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimeUtc</_Parameter1>
      <_Parameter2>$(BuildTimeUtc)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Configuration\ImageMagick\policy.xml"
             Link="ImageMagick\policy.xml"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always" />
    <Content Include="ThirdPartyNotices\*.txt"
             Link="ThirdPartyNotices\%(Filename)%(Extension)"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always" />
    <Content Include="..\deploy\Updates\install-github-release.ps1"
             Link="updater-payload\install-github-release.ps1"
             CopyToPublishDirectory="Always" />
    <Content Include="..\deploy\Updates\update-helper.ps1"
             Link="updater-payload\update-helper.ps1"
             CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
