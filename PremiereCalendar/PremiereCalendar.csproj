             Link="updater-payload\install-github-release.ps1"
             CopyToPublishDirectory="Always" />
    <Content Include="..\deploy\Updates\update-helper.ps1"
             Link="updater-payload\update-helper.ps1"
             CopyToPublishDirectory="Always" />
