{
  "AppDatabase": {
    "Path": "../../PremiereCalendar.LocalData/data/premiere-calendar.db",
    "MigrationBackupDirectory": "../../PremiereCalendar.LocalData/backups/database-migrations",
    "MigrationBackupRetentionCount": 3
  },
  "CalendarCache": {
    "Directory": "../../PremiereCalendar.LocalData/cache/calendar"
  },
  "CalendarWarmup": {
    "CleanupRetentionDays": 14
  },
  "CacheMaintenance": {
    "RetentionDays": 14
  },
  "ImageCache": {
    "Directory": "../../PremiereCalendar.LocalData/cache/images",
    "CacheDays": 14
  },
  "Telemetry": {
    "LogDirectory": "../../PremiereCalendar.LocalData/logs",
    "FileSizeLimitMegabytes": 10,
    "RetainedFileCount": 5
  },
  "ApplicationUpdate": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
