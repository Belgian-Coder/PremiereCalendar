{
  "AppDatabase": {
    "ConnectionString": "Host=127.0.0.1;Port=55432;Database=premierecalendar;Username=premierecalendar",
    "PasswordFile": "../.secrets/dev-postgres-password"
  },
  "CalendarCache": {
    "Directory": "../.local-data/cache/calendar"
  },
  "CalendarWarmup": {
    "CleanupRetentionDays": 14
  },
  "CacheMaintenance": {
    "RetentionDays": 14
  },
  "ImageCache": {
    "Directory": "../.local-data/cache/images",
    "CacheDays": 14
  },
  "Telemetry": {
    "LogDirectory": "../.local-data/logs",
    "FileSizeLimitMegabytes": 10,
    "RetainedFileCount": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
