    "AppName": "premiere-calendar",
    "AppVersion": "1.0",
    "Enabled": true,
    "RequestTimeoutSeconds": 20,
    "MinimumActivityCheckMinutes": 30
  },
  "CalendarCache": {
    "Enabled": true,
    "Directory": "App_Data/cache/calendar",
    "WeekCacheHours": 6,
    "AdjacentWeekPrefetchEnabled": true,
    "FuturePrefetchWeeks": 4,
    "PastPrefetchWeeks": 2,
    "AdjacentWeekPrefetchTimeoutSeconds": 30
  },
  "CalendarWarmup": {
    "Enabled": true,
    "RunOnStartup": true,
    "StartupDelaySeconds": 10,
    "WakeIntervalMinutes": 15,
    "MinimumRemoteRefreshMinutes": 60,
    "MaximumProfilesPerWake": 5,
    "MaximumRemoteWindowsPerWake": 4,
    "TopFilterProfileCount": 4,
    "SkipWhenForegroundLoadActive": true,
    "CleanupRetentionDays": 60,
    "CycleBudgetSeconds": 600,
    "WindowBudgetSeconds": 90,
    "StaleOnlyRemoteRefresh": true
  },
  "CalendarLoad": {
    "ForegroundLoadBudgetSeconds": 45
  },
  "CacheMaintenance": {
    "Enabled": true,
    "RetentionDays": 60,
    "SweepIntervalHours": 24
  },
  "ProviderDeltaSync": {
    "Enabled": true,
    "RunOnStartup": true,
    "StartupDelaySeconds": 20,
    "WakeIntervalMinutes": 60,
    "TmdbLookbackDays": 14,
    "UseTmdbChanges": true,
    "UseTvmazeUpdates": true
  },
  "ProviderScheduler": {
    "Enabled": true,
    "LeaseSeconds": 120,
    "MaximumAttempts": 5,
    "CompletedRetentionDays": 7
  },
  "Telemetry": {
    "Enabled": true,
    "ServiceName": "PremiereCalendar",
    "LogDirectory": "App_Data/logs",
    "FileSizeLimitMegabytes": 50,
    "RetainedFileCount": 14,
    "OtlpEndpoint": "",
    "TraceSampleRatio": 1.0
  },
  "ApplicationUpdate": {
    "Enabled": true,
    "UpdaterScriptPath": "D:\\Apps\\PremiereCalendar\\updater\\install-github-release.ps1",
    "LogDirectory": "D:\\Apps\\PremiereCalendarData\\logs\\application-updates",
    "PowerShellPath": "powershell.exe",
