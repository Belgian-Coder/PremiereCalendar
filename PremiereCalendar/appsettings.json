{
  "Urls": "http://0.0.0.0:5298",
  "Hosting": {
    "ForwardedProxies": [ "192.168.68.22" ]
  },
  "Tmdb": {
    "BaseUrl": "https://api.themoviedb.org/3/",
    "ImageBaseUrl": "https://image.tmdb.org/t/p/",
    "PosterSize": "w185",
    "BackdropSize": "w780",
    "DefaultLookAheadDays": 42,
    "MaxPagesPerQuery": 500,
    "MaxUnfilteredPagesPerQuery": 500,
    "SourceFetchConcurrency": 12,
    "PageBatchSize": 10,
    "PageFetchConcurrency": 6,
    "MaxEnrichmentConcurrency": 16,
    "EnrichmentProgressBatchSize": 25,
    "ExternalCandidateBatchSize": 100,
    "RequestTimeoutSeconds": 20,
    "SourceTimeoutSeconds": 45,
    "MaxRequestsPerSecond": 20,
    "MaxConcurrentRequests": 4
  },
  "Omdb": {
    "BaseUrl": "https://www.omdbapi.com/",
    "Enabled": false,
    "CacheDays": 90,
    "EmptyResponseCacheHours": 6,
    "RateLimitBackoffHours": 12
  },
  "ImdbDataset": {
    "Enabled": true,
    "RatingsUrl": "https://datasets.imdbws.com/title.ratings.tsv.gz",
    "RefreshIntervalHours": 24,
    "RefreshOnStartup": true,
    "StartupDelaySeconds": 30,
    "RequestTimeoutSeconds": 120
  },
  "Tvmaze": {
    "BaseUrl": "https://api.tvmaze.com/",
    "Enabled": true,
    "EnableScheduleDiscovery": true,
    "ScheduleFetchConcurrency": 4,
    "MaxConcurrentRequests": 4
  },
  "Fanart": {
    "BaseUrl": "https://webservice.fanart.tv/v3/",
    "Enabled": false
  },
  "Trakt": {
    "BaseUrl": "https://api.trakt.tv/",
    "Enabled": true,
    "ApiVersion": "2"
  },
  "TheTvdb": {
    "BaseUrl": "https://api4.thetvdb.com/v4/",
    "ImageBaseUrl": "https://artworks.thetvdb.com/banners/",
    "Enabled": false
  },
  "Wikimedia": {
    "WikidataBaseUrl": "https://www.wikidata.org/",
    "CommonsApiUrl": "https://commons.wikimedia.org/w/api.php",
    "Enabled": true
  },
  "RottenTomatoes": {
    "BaseUrl": "https://www.rottentomatoes.com/",
    "Enabled": true,
    "CacheHours": 24,
    "RequestTimeoutSeconds": 20
  },
  "Watchmode": {
    "BaseUrl": "https://api.watchmode.com/v1/",
    "Enabled": true,
    "Regions": [ "BE", "NL" ],
