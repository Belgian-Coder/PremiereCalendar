<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
    <FileVersion Condition="'$(FileVersion)' == ''">0.0.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">0.0.0-local</InformationalVersion>
    <DatabaseSchemaVersion>3</DatabaseSchemaVersion>
    <!-- Keep routine local build output out of the source checkout. Hosted CI
         keeps its conventional layout for existing artifact collection. -->
    <UseArtifactsOutput Condition="'$(UseArtifactsOutput)' == '' and '$(CI)' != 'true'">true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == '' and '$(CI)' != 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../PremiereCalendar.Build'))</ArtifactsPath>
  </PropertyGroup>
</Project>
