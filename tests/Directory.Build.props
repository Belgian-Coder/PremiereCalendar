<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Settings shared by every test project. xUnit.net v3 test projects are executables that run on
       Microsoft Testing Platform (MTP v2, the xunit.v3 default). `dotnet test` uses MTP through the
       "test" section of global.json; the produced executable can also be run directly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <XunitV3Version>4.0.3</XunitV3Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="$(XunitV3Version)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
