<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="PremiereCalendar.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PremiereCalendar\PremiereCalendar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);POSTGRES_TEST_INPROCESS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\PostgresTestDatabase.cs" Link="Support\PostgresTestDatabase.cs" />
  </ItemGroup>

</Project>
